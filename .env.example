# =========================================================
# OmniStyle Customer Intelligence Platform - Environment Config
# Copy this file to ".env" and fill in your own values.
# NEVER commit your real .env file to version control.
# =========================================================

# ---- MongoDB Atlas (existing cluster) ----
# Use your existing Atlas cluster connection string.
# This project ONLY reads/writes the database named by MONGODB_DB below.
# It will never touch any other database on your cluster.
MONGODB_URI=mongodb+srv://<username>:<password>@<your-existing-cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=omnistyle_intelligence

# ---- MySQL (analytics database) ----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=omnistyle_analytics

# ---- Reproducibility ----
RANDOM_SEED=42

# ---- Synthetic data volume (optional overrides) ----
NUM_CUSTOMERS=5000
NUM_PRODUCTS=200
NUM_ORDERS=35000
